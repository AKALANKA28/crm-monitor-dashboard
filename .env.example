# Use dummy for local testing. Change to mssql when SQL Server credentials are ready.
APP_DATA_SOURCE=dummy
APP_TITLE=CRM Request Monitor

# SQL Server settings. You can use either a full connection string or the individual values below.
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=YourDb;UID=your_user;PWD=your_password;TrustServerCertificate=yes;
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=YourDatabase
SQLSERVER_USERNAME=your_user
SQLSERVER_PASSWORD=your_password
SQLSERVER_TRUST_CERTIFICATE=yes

# Table and column names. Adjust if your real DB uses different names.
DB_TABLE=dbo.Customers
DB_CREATED_AT_COLUMN=CreatedAt
DB_STATUS_COLUMN=CRMStatus
DB_REQUEST_ID_COLUMN=RequestId
