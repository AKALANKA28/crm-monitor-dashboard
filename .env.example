# Use dummy for local testing. Change to azure when Azure SQL credentials are ready.
APP_DATA_SOURCE=dummy
APP_TITLE=CRM Request Monitor

# Azure SQL settings. You can use either a full connection string or the individual values below.
# DB_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=sql-server.database.windows.net;DATABASE=YourDb;UID=your_user;PWD=your_password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=sql-server.database.windows.net
DB_DATABASE=YourDatabase
DB_USERNAME=your_user
DB_PASSWORD=your_password
DB_ENCRYPT=yes
DB_TRUST_CERTIFICATE=no
DB_CONNECTION_TIMEOUT=30

# Table and column names. Adjust if your real DB uses different names.
DB_TABLE=dbo.Customers
DB_CREATED_AT_COLUMN=CreatedAt
DB_STATUS_COLUMN=CRMStatus
DB_REQUEST_ID_COLUMN=RequestId
